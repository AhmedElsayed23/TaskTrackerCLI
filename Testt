			DEBIT.CUSTOMER = R.DEBITCU<AC.CUSTOMER>
			CALL F.READ(FN.CUSTOMER,DEBIT.CUSTOMER,R.CUSDET,F.CUSTOMER,ERR.CU)
			IF R.CUSDET THEN
			    DEBIT.CUSTOMER.NAME = R.CUSDET<EB.CUS.NAME.1,1>
			END
		    END
		    OFSRECORD := 'TRANSACTION.TYPE=':TXN_TYPE:','
		    OFSRECORD := 'DEBIT.ACCT.NO=':S_ACC_ID:','
		    OFSRECORD := 'DEBIT.CURRENCY=':S_CURR_CD:','
		    OFSRECORD := 'DEBIT.AMOUNT=':S_AMT:','
		    OFSRECORD := 'DEBIT.VALUE.DATE=':VALUE_DT:','
		    OFSRECORD := 'CREDIT.VALUE.DATE=':VALUE_DT:','
		    OFSRECORD := 'CREDIT.ACCT.NO=':T_ACC_ID:','
		    OFSRECORD := 'FT.TXN.NARR=':S_NARR_DTLS[1,35]:','
