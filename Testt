********************************************************************************
CHECK.LINE:
**********
    CLOSE.OPEN.TAG.COUNTER = DCOUNT(R.CIB.SMS.FORMAT<CIBSF.BODY.NAME>,VM)
    FOR X = 1 TO CLOSE.OPEN.TAG.COUNTER
        TEMP.VALUE = R.CIB.SMS.FORMAT<CIBSF.BODY.NAME>
        Y.FILE.BODY.NAME = FIELD(TEMP.VALUE,VM,X)
        BODYNAME.COUNT = COUNT(TEMP.MSG,"@@":Y.FILE.BODY.NAME)

* MCBCS-201800702-S
*        IF BODYNAME.COUNT > 0 THEN
        IF BODYNAME.COUNT GT 0 THEN
* MCBCS-201800702-E
* MCBCS-201800702-S
*            IF Y.FILE.BODY.NAME <> "" THEN
            IF Y.FILE.BODY.NAME NE "" THEN
* MCBCS-201800702-E
*                NO.OF.TAGS ++
                NO.OF.TAGS = NO.OF.TAGS + 1
                BODY.ARRAY.NAME<NO.OF.TAGS> = Y.FILE.BODY.NAME
                GOSUB READ.BODY.FIELD
* MCBCS-201800702-S
*                IF Y.NEW.VALUE <> "NULL" THEN
                IF Y.NEW.VALUE NE "NULL" THEN
* MCBCS-201800702-E
                    BODY.ARRAY.VALUE<NO.OF.TAGS> = Y.NEW.VALUE.BEFORE
                    CHANGE "@@":Y.FILE.BODY.NAME TO Y.NEW.VALUE IN TEMP.MSG
* MCBCS-201800702-S
*                    IF Y.FILE.BODY.NAME = "AMT" THEN
                    IF Y.FILE.BODY.NAME EQ "AMT" THEN
* MCBCS-201800702-E
                        Y.AMOUNT.VALUE = Y.NEW.VALUE
                    END
                    MSG.FORMAT<NO.OF.LINES> = TEMP.MSG
                    NEW.LINE = MSG.FORMAT
                    GOSUB WRITE.NEW.LINE
                END
                ELSE
                    NEW.LINE = "ERORR IN CREATING MESSAGE FOR ":SMS.FORMAT.ID:" IN GETTING ":Y.FILE.BODY.NAME
                    GOSUB WRITE.NEW.LINE
                END
            END
        END
    NEXT X

    RETURN
*****************************************************************************
READ.BODY.FIELD:
****************
    Y.BODY.NAME = R.CIB.SMS.FORMAT<CIBSF.BODY.NAME>
    CHANGE VM TO FM IN Y.BODY.NAME
    LOCATE Y.FILE.BODY.NAME IN Y.BODY.NAME SETTING POS.ID THEN
        NEW.LINE = Y.FILE.BODY.NAME:MY.SEP:"FIELD LOCATED"
        GOSUB WRITE.NEW.LINE
        GOSUB CHANGE.VALUE
        Y.NEW.VALUE.BEFORE = Y.NEW.VALUE

        MV.POS = R.CIB.SMS.FORMAT<CIBSF.MV.POS,POS.ID>
* MCBCS-201800702-S
*        IF MV.POS <> "" THEN
        IF MV.POS NE "" THEN
* MCBCS-201800702-E
            SV.POS = R.CIB.SMS.FORMAT<CIBSF.SV.POS,POS.ID>
* MCBCS-201800702-S
*            IF SV.POS <> "" THEN
            IF SV.POS NE "" THEN
* MCBCS-201800702-E
                Y.NEW.VALUE = FIELD(Y.NEW.VALUE,VM,MV.POS)
                Y.NEW.VALUE = FIELD(Y.NEW.VALUE,SM,SV.POS)
            END
            ELSE
                Y.NEW.VALUE = FIELD(Y.NEW.VALUE,VM,MV.POS)
            END
        END
        ELSE
            SV.POS = R.CIB.SMS.FORMAT<CIBSF.SV.POS,POS.ID>
* MCBCS-201800702-S
*            IF SV.POS <> "" THEN
            IF SV.POS NE "" THEN
* MCBCS-201800702-E
                Y.NEW.VALUE = FIELD(Y.NEW.VALUE,SM,SV.POS)
            END
        END
        FROM.POS = R.CIB.SMS.FORMAT<CIBSF.FROM.POS,POS.ID>
        TO.POS = R.CIB.SMS.FORMAT<CIBSF.LENGTH.POS,POS.ID>
* MCBCS-201800702-S
*        IF FROM.POS <> "" THEN
        IF FROM.POS NE "" THEN
* MCBCS-201800702-E
* MCBCS-201800702-S
*            IF TO.POS <> "" THEN
            IF TO.POS NE "" THEN
* MCBCS-201800702-E
                Y.NEW.VALUE = Y.NEW.VALUE[FROM.POS,TO.POS]
            END
        END
        CHANGE VM TO " " IN Y.NEW.VALUE
        CHANGE FM TO " " IN Y.NEW.VALUE
        CHANGE SM TO " " IN Y.NEW.VALUE
*  GOSUB CHECK.PROTECT
        GOSUB CHECK.DATE
    END
    RETURN
********************************************************************************
CHANGE.VALUE:
*************
    Y.APP.NAME.MAIN  = R.CIB.SMS.FORMAT<CIBSF.SMS.APP.NAME>
    Y.APP.NAME = R.CIB.SMS.FORMAT<CIBSF.APP.NAME,POS.ID>
* MCBCS-201800702-S
*    IF Y.APP.NAME <> "MAIN" THEN
    IF Y.APP.NAME NE "MAIN" THEN
* MCBCS-201800702-E
        OLD.POS.ID = POS.ID

* MCBCS-201800702-S
*        IF R.CIB.SMS.FORMAT<CIBSF.APP.READ.ID,POS.ID> = "YES" THEN
        IF R.CIB.SMS.FORMAT<CIBSF.APP.READ.ID,POS.ID> EQ "YES" THEN
* MCBCS-201800702-E
            GOSUB GET.APP.ID
            GOSUB GET.READ.VALUE
            Y.NEW.VALUE = Y.GET.VALUE
        END
* MCBCS-201800702-S
*        IF R.CIB.SMS.FORMAT<CIBSF.APP.READ.ID,POS.ID> = "OTHER" THEN
        IF R.CIB.SMS.FORMAT<CIBSF.APP.READ.ID,POS.ID> EQ "OTHER" THEN
* MCBCS-201800702-E
            COUNTER = 1
            GOSUB GET.APP.ID
            GOSUB GET.READ.VALUE
            GOSUB GET.OTHERS
            Y.NEW.VALUE = Y.GET.VALUE
        END
        POS.ID = OLD.POS.ID
    END
    ELSE
        Y.MAIN.F.NAME = R.CIB.SMS.FORMAT<CIBSF.APP.FIELD.NAME,POS.ID>
* MCBCS-201800702-S
*        IF Y.MAIN.F.NAME = "ID.VAL" THEN
        IF Y.MAIN.F.NAME EQ "ID.VAL" THEN
* MCBCS-201800702-E
            Y.NEW.VALUE = ID.NEW
        END
        ELSE
            Y.MAIN.F.NAME.OLD = Y.MAIN.F.NAME
* MCBCS-201800702-S
*            IF Y.MAIN.F.NAME = "MSG.ID" THEN
            IF Y.MAIN.F.NAME EQ "MSG.ID" THEN
* MCBCS-201800702-E
                Y.MAIN.F.NAME = "INT.MSG.NUM.1"
            END

            SS.REQ.FIELD = Y.MAIN.F.NAME
            Y.SS.TABLE = Y.APP.NAME.MAIN
            GOSUB GET.SS.FIELD.NO
* MCBCS-201800702-S
*            IF SS.FIELD.NO = "" THEN
            IF SS.FIELD.NO EQ "" THEN
* MCBCS-201800702-E
                GOSUB GET.SS.USER.FIELD.NO
* Y.MAIN.F.NAME= SS.FIELD.NO
*           Y.NEW.VALUE = R.NEW(Y.MAIN.F.NAME)
                CHANGE ">" TO "" IN LOCAL.FIELD.POS
                LOCAL.FIELD.POS = FIELD(LOCAL.FIELD.POS,",",2)
                ALL.FIELD = R.READ.MAIN.APP.NEW<LOCAL.REF.FIELD.NO>
                Y.NEW.VALUE = FIELD(ALL.FIELD,VM,LOCAL.FIELD.POS)
*       Y.NEW.VALUE = R.NEW(LOCAL.REF.FIELD.NO)LOCAL.FIELD.POS
            END
            ELSE
                Y.MAIN.F.NAME= SS.FIELD.NO
                Y.NEW.VALUE = R.READ.MAIN.APP.NEW<Y.MAIN.F.NAME>
            END

* MCBCS-201800702-S
*            IF Y.MAIN.F.NAME.OLD = "MSG.ID" THEN
            IF Y.MAIN.F.NAME.OLD EQ "MSG.ID" THEN
* MCBCS-201800702-E
                Y.MAIN.F.NAME = Y.MAIN.F.NAME.OLD
* MCBCS-201800702-S
*                IF Y.NEW.VALUE = "" THEN
                IF Y.NEW.VALUE EQ "" THEN
* MCBCS-201800702-E
                    Y.NEW.VALUE = ID.NEW
                END
            END

        END

    END
    RETURN
********************************************************************************
GET.OTHERS:
***********
    Y.APP.ID = Y.GET.VALUE
    Y.FILE.BODY.NAME.OTHERS = Y.FILE.BODY.NAME:".":COUNTER
    LOCATE Y.FILE.BODY.NAME.OTHERS IN Y.BODY.NAME SETTING POS.ID THEN
        NEW.LINE = Y.FILE.BODY.NAME.OTHERS:MY.SEP:"FIELD LOCATED"
        GOSUB WRITE.NEW.LINE
        Y.APP.ID = Y.GET.VALUE
        GOSUB GET.READ.VALUE
        GOSUB CHECK.OTHER
    END
    RETURN
********************************************************************************
CHECK.OTHER:
************
* MCBCS-201800702-S
*    IF R.CIB.SMS.FORMAT<CIBSF.APP.READ.ID,POS.ID> = "OTHER" THEN
    IF R.CIB.SMS.FORMAT<CIBSF.APP.READ.ID,POS.ID> EQ "OTHER" THEN
* MCBCS-201800702-E
*        COUNTER ++
        COUNTER = COUNTER + 1
        GOSUB GET.OTHERS
    END
    RETURN
********************************************************************************
GET.APP.ID:
***********
    Y.APP.ID =  R.CIB.SMS.FORMAT<CIBSF.APP.ID,POS.ID>
    SS.REQ.FIELD = Y.APP.ID
    Y.SS.TABLE = Y.APP.NAME.MAIN
    GOSUB GET.SS.FIELD.NO
* MCBCS-201800702-S
*    IF SS.FIELD.NO = "" THEN
    IF SS.FIELD.NO EQ "" THEN
* MCBCS-201800702-E
        GOSUB GET.SS.USER.FIELD.NO
*       Y.APP.ID = R.NEW(LOCAL.REF.FIELD.NO, LOCAL.FIELD.POS)
        CHANGE ">" TO "" IN LOCAL.FIELD.POS
        LOCAL.FIELD.POS = FIELD(LOCAL.FIELD.POS,",",2)
        ALL.FIELD = R.READ.MAIN.APP.NEW<LOCAL.REF.FIELD.NO>
        Y.APP.ID = FIELD(ALL.FIELD,VM,LOCAL.FIELD.POS)

* Y.APP.ID = SS.FIELD.NO
* Y.APP.ID =  R.NEW(Y.APP.ID)
    END
    ELSE
        Y.APP.ID = SS.FIELD.NO
        Y.APP.ID = R.READ.MAIN.APP.NEW<Y.APP.ID>
    END
    GOSUB CHECK.POSITIONS
    RETURN
********************************************************************************
CHECK.POSITIONS:
***************
    FROM.POS = R.CIB.SMS.FORMAT<CIBSF.FROM.POS,POS.ID>
    TO.POS = R.CIB.SMS.FORMAT<CIBSF.LENGTH.POS,POS.ID>
* MCBCS-201800702-S
*    IF FROM.POS <> "" THEN
    IF FROM.POS NE "" THEN
* MCBCS-201800702-E
* MCBCS-201800702-S
*        IF TO.POS <> "" THEN
        IF TO.POS NE "" THEN
* MCBCS-201800702-E
            Y.APP.ID = Y.APP.ID[FROM.POS,TO.POS]
        END
    END
    RETURN
********************************************************************************
GET.READ.VALUE:
***************
* MCBCS-201800702-S
*    IF Y.APP.ID <> "" THEN
    IF Y.APP.ID NE "" THEN
* MCBCS-201800702-E
        APP.NAME = R.CIB.SMS.FORMAT<CIBSF.APP.NAME,POS.ID>
        FILE.EXT = R.CIB.SMS.FORMAT<CIBSF.APP.TYPE,POS.ID>:"."
        GOSUB READ.OPEN.FILE
        CALL F.READ(FN.APP.NAME, Y.APP.ID,R.APP.NAME,F.APP.NAME,ERR1)
        IF R.APP.NAME THEN
            Y.APP.FIELD.NAME = R.CIB.SMS.FORMAT<CIBSF.APP.FIELD.NAME,POS.ID>
            SS.REQ.FIELD = Y.APP.FIELD.NAME
            Y.SS.TABLE = APP.NAME
            GOSUB GET.SS.FIELD.NO
* MCBCS-201800702-S
*            IF SS.FIELD.NO = "" THEN
            IF SS.FIELD.NO EQ "" THEN
* MCBCS-201800702-E
                GOSUB GET.SS.USER.FIELD.NO

                CHANGE ">" TO "" IN LOCAL.FIELD.POS
                LOCAL.FIELD.POS = FIELD(LOCAL.FIELD.POS,",",2)
                ALL.FIELD = R.APP.NAME<LOCAL.REF.FIELD.NO>
                Y.GET.VALUE = FIELD(ALL.FIELD,VM,LOCAL.FIELD.POS)

* Y.GET.VALUE = R.APP.NAME<LOCAL.REF.FIELD.NO,LOCAL.FIELD.POS>
            END
            ELSE
                Y.APP.FIELD.NAME = SS.FIELD.NO
                Y.GET.VALUE = R.APP.NAME<Y.APP.FIELD.NAME>
            END
            CHANGE VM TO " " IN Y.GET.VALUE
            CHANGE FM TO " " IN Y.GET.VALUE
        END
    END
    RETURN
********************************************************************************
CHECK.DATE:
***********
    DATE.FLAG = R.CIB.SMS.FORMAT<CIBSF.DATE.VA,POS.ID>
* MCBCS-201800702-S
*    IF DATE.FLAG = "YES" THEN
    IF DATE.FLAG EQ "YES" THEN
* MCBCS-201800702-E

* MCBCS-201800702-S
*        IF LEN(Y.NEW.VALUE) > 9 THEN
        IF LEN(Y.NEW.VALUE) GT 9 THEN
* MCBCS-201800702-E
            Y.NEW.VALUE.DATE = OCONV(ICONV(Y.NEW.VALUE[1,6],"D2/"),'D4')
            CHANGE " " TO "-" IN Y.NEW.VALUE.DATE
            TIME.HH = Y.NEW.VALUE[7,2]
            TIME.MM = Y.NEW.VALUE[9,2]
* MCBCS-201800702-S
*            IF TIME.HH <> "" THEN
            IF TIME.HH NE "" THEN
* MCBCS-201800702-E
* MCBCS-201800702-S
*                IF TIME.MM <> "" THEN
                IF TIME.MM NE "" THEN
* MCBCS-201800702-E
                    Y.NEW.VALUE.TIME = TIME.HH:":":TIME.MM:":00"
                END
                ELSE
                    Y.NEW.VALUE.TIME = TIME.HH:":00:00"
                END
            END
        END
        ELSE
            Y.NEW.VALUE.DATE = OCONV(ICONV(Y.NEW.VALUE[1,8],"D2/"),'D4')
            CHANGE " " TO "-" IN Y.NEW.VALUE.DATE
            Y.NEW.VALUE.TIME = "00:00:00"
        END
        Y.NEW.VALUE = Y.NEW.VALUE.DATE:" ":Y.NEW.VALUE.TIME
    END
    RETURN
********************************************************************************
CHECK.PROTECT:
**************
    PROTECT.FLAG = R.CIB.SMS.FORMAT<CIBSF.PROTECTED,POS.ID>
* MCBCS-201800702-S
*    IF PROTECT.FLAG = "YES" THEN
    IF PROTECT.FLAG EQ "YES" THEN
* MCBCS-201800702-E
        PROTECT.DIRECTION = R.CIB.SMS.FORMAT<CIBSF.L.R,POS.ID>
        PROTECT.CHAR = R.CIB.SMS.FORMAT<CIBSF.NO.CHA,POS.ID>
* MCBCS-201800702-S
*        IF PROTECT.DIRECTION = "L" THEN
        IF PROTECT.DIRECTION EQ "L" THEN
* MCBCS-201800702-E
            PRO.VALUE = LEFT(Y.NEW.VALUE,PROTECT.CHAR)
            NEW.PRO.VALUE = FMT(NEW.PRO.VALUE,"L0*":PROTECT.CHAR)
            Y.NEW.VALUE = CHANGE(Y.NEW.VALUE,PRO.VALUE,NEW.PRO.VALUE)
            NEW.LINE = " AFTER PROTECT":Y.NEW.VALUE:" ":NEW.PRO.VALUE:" ":PRO.VALUE
            GOSUB WRITE.NEW.LINE

        END
        ELSE
            PRO.VALUE = RIGHT(Y.NEW.VALUE,PROTECT.CHAR)
            NEW.PRO.VALUE = FMT(NEW.PRO.VALUE,"L0*":PROTECT.CHAR)
            Y.NEW.VALUE = CHANGE(Y.NEW.VALUE,PRO.VALUE,NEW.PRO.VALUE)
            NEW.LINE = " AFTER PROTECT":Y.NEW.VALUE:" ":NEW.PRO.VALUE:" ":PRO.VALUE
            GOSUB WRITE.NEW.LINE

        END
    END
    RETURN
