*-----------------------------------------------------------------------------
* <Rating>-20</Rating>
*-----------------------------------------------------------------------------
    SUBROUTINE U.FILE.PROCESS.M.CIB(Y.IN,Y.OUT)
    $INSERT I_COMMON
    $INSERT I_EQUATE

    GOSUB INIT.OPENFILES
    GOSUB MAIN.PROCESS
    RETURN
*-----------------------------------------------------------------------------
INIT.OPENFILES:
*-------------*
    Y.TYPE = ''
    Y.SOURCE.PATH = ''
    Y.DESTINATION.PATH = ''
    Y.DESTINATION.FILENAME = ''
    Y.PARAM.SEPARATOR = ''
    Y.TEMP.CNT = ''

    RETURN
*-----------------------------------------------------------------------------
MAIN.PROCESS:
*-----------*
*DEBUG

    Y.TYPE = FIELD(Y.IN,'#',1)
    Y.SOURCE.PATH = FIELD(Y.IN,'#',2)
    Y.DESTINATION.PATH = FIELD(Y.IN,'#',3)
    Y.DESTINATION.FILENAME = FIELD(Y.IN,'#',4)
    Y.PARAM.SEPARATOR = FIELD(Y.IN,'#',5)

    Y.FILENAME.CNT = DCOUNT(Y.SOURCE.PATH,'/')
    Y.TEMP.CNT = Y.FILENAME.CNT-1
    Y.FILENAME = FIELD(Y.SOURCE.PATH,'/',Y.FILENAME.CNT)
    Y.DIR = FIELD(Y.SOURCE.PATH,'/',1,Y.TEMP.CNT)


    BEGIN CASE
    CASE Y.TYPE EQ 'rm'
        IF (Y.DIR NE '') AND (Y.FILENAME NE '') THEN
            CALL OCOMO("Executing Delete Operation for the file ":Y.DIR:" ":Y.FILENAME)
            EXECUTE 'DELETE ':Y.DIR:' ':Y.FILENAME
        END

    END CASE
    RETURN
*-----------------------------------------------------------------------------
END
