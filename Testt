	*CUR.VAR = T_AMT
	*GOSUB AMOUNT.FORMAT
	*T_AMT = CUR.VAR

	CUR.VAR = VALUE_DT

	VALUE_DT = CUR.VAR

	S_NARR_DTLS = S_NARR_DTLS
	ERR.FILE = ''
	CALL F.READ(FN.FILE.AC,S_ACC_ID,R.ACDE,F.FILE.AC,ERR.FILE)
	IF R.ACDE THEN

	    DEBIT.CUSTOMER = R.ACDE<AC.CUSTOMER>

	    Y.DEBIT.CURRENCY = R.ACDE<AC.CURRENCY>
            Y.POSTING = R.ACDE<AC.POSTING.RESTRICT>
	    CALL F.READ(FN.CUSTOMER,DEBIT.CUSTOMER,R.CUSTOMER,F.CUSTOMER,ERR.FILE)
	    IF R.CUSTOMER THEN

		IF R.CUSTOMER<EB.CUS.POSTING.RESTRICT> THEN

		Y.POSTING := FM : R.CUSTOMER<EB.CUS.POSTING.RESTRICT>

		END
		Y.KYC.POSTIING = "35"
		CHANGE VM TO FM IN Y.POSTING
		LOCATE Y.KYC.POSTIING IN Y.POSTING SETTING POS.ID THEN

		IF T_ACC_ID[1,1] EQ '4' OR  T_ACC_ID[1,1] EQ '5' OR TXN_TYPE EQ 'ACTR' THEN

                	KYC.POS = 'TRUE'

		END
		ELSE
		    OFSRECORD = 'KYC Need to be updated '
		    REPLY.CODE = '0035'
		    NEW.SEND.FLAG= "NO"
		    TEMP.SEND = "NO"
		END
		END
	    END
	    MAIN.CUSTOMER = DEBIT.CUSTOMER
	    STAFF.CUSTOMEER = "FALSE"

	    IF R.ACDE<AC.RELATION.CODE,1> EQ  99 THEN

		DEBIT.CUSTOMER = R.ACDE<AC.JOINT.HOLDER,1>
		STAFF.CUSTOMEER = "TRUE"
	    END

	    LIMIT.BALANCE = 0 ; LOCK.AMOUNT = 0 ; BOOK.BALANCE = 0 ; CLEAR.BALANCE = 0 ;  AVAL.BALANCE = 0  ; LIMIT.EXPIRY = 0
	    CALL GET.NET.AVL.BL(S_ACC_ID,LIMIT.BALANCE,LIMIT.EXPIRY,LOCK.AMOUNT,BOOK.BALANCE,CLEAR.BALANCE,AVAL.BALANCE)

	    SUF.BAL = AVAL.BALANCE * 1
	END

	IF TXN_TYPE EQ 'OT03' THEN
	    GOSUB SET.NEW.VALUES
	END
	ORG_AC = T_ACC_ID
	GROUP.ACCOUNT = T_ACC_ID
	IF NEW.SEND.FLAG = "TRUE" THEN

	    IF IPN.FLAG EQ "TRUE" THEN
		TXN_TYPE = 'ACIO'
	    END
	    IF TXN_TYPE EQ 'OT03' THEN
		CR.ACC = ''
		ERR.FILE = ''
		CALL F.READ(FN.FILE.NOS,T_CURR_CD,R.NOS,F.FILE.NOS,ERR.FILE)
		IF R.NOS THEN

		    CR.ACC = R.NOS<NOS.T24.NOS.ACCOUNT.NO>
		END
		ELSE
		    CR.ACC = ''
		END

		VER.NAME = VER1
		IF T_CURR_CD = "EGP" THEN
		    CR.ACC = CREDIT.ACC.NO
		END

		GOSUB INIT.OFS.MSG

		OFSRECORD := 'DEBIT.ACCT.NO=':S_ACC_ID:','
		OFSRECORD := 'DEBIT.CURRENCY=':S_CURR_CD:','
		OFSRECORD := 'DEBIT.VALUE.DATE=':VALUE_DT:','
		OFSRECORD := 'CREDIT.VALUE.DATE=':VALUE_DT:','
		OFSRECORD := 'CREDIT.ACCT.NO=':CR.ACC:','
		OFSRECORD := 'CREDIT.CURRENCY=':T_CURR_CD:','
		OFSRECORD := 'CREDIT.AMOUNT=':T_AMT:','


		IF Y.FREE.MARKET.CODE NE '' THEN
		    OFSRECORD := 'FREE.MARKT.CODE=':Y.FREE.MARKET.CODE:','
		END
		TEMP.VALUE = "."
		OFSRECORD := 'BK.TO.BK.OUT:1:1=':TEMP.VALUE:','
		TEMP.LEN = LEN(BEN_NARRATIVE)
		TEMP.COUNT = TEMP.LEN / 35
		IF FIELD(TEMP.COUNT,'.',2) GT 0 THEN
		    TEMP.COUNT =  FIELD(TEMP.COUNT,'.',1)
		    TEMP.COUNT = TEMP.COUNT + 1
		END
		NEW.COUNT = 1
		IF TEMP.LEN GE 35 THEN
		    FOR I = 1 TO TEMP.COUNT
			TEMP.VALUE = BEN_NARRATIVE[NEW.COUNT,35]
			OFSRECORD := 'PAYMENT.DETAILS:':I:':=':TEMP.VALUE:','
			NEW.COUNT = NEW.COUNT + 35
		    NEXT
		END
		ELSE
		    OFSRECORD := 'PAYMENT.DETAILS:1:=':BEN_NARRATIVE[1,35]:','
		END

		TEMP.NARR.DEBIT.THEIR = "Online Transfer"

		OFSRECORD := 'DEBIT.THEIR.REF=':TEMP.NARR.DEBIT.THEIR[1,15]:','

		COUNT.AR = DCOUNT(BEN_NARRATIVE,"?")
		IF COUNT.AR GT 1 AND NEW.AUTH.FLAG = "0" THEN
		    NEW.AUTH.FLAG = "1"
		END
		Y.BEN.CUSTOMER = BEN_NAME
		Y.BEN.CUSTOMER = TRIM(Y.BEN.CUSTOMER)
		TEMP.BEN.NAME = TRIM(BEN_NAME[1,35])
		COUNT.AR = DCOUNT(TEMP.BEN.NAME,"?")
		IF COUNT.AR GT 1 AND NEW.AUTH.FLAG = "0" THEN
		    NEW.AUTH.FLAG = "1"
		END
		IF TEMP.BEN.NAME NE "" THEN
		    OFSRECORD := 'BEN.CUSTOMER:1:=':TEMP.BEN.NAME:','
		    NEW.COUNT = 2
		END
		TEMP.BEN.NAME = TRIM(BEN_NAME[36,35])
		IF TEMP.BEN.NAME NE "" THEN
		    OFSRECORD := 'BEN.CUSTOMER:2:=':TEMP.BEN.NAME:','
		    NEW.COUNT = 3
		END


		TEMP.LEN = LEN(BEN.ADD)
		TEMP.COUNT = TEMP.LEN / 35
		IF FIELD(TEMP.COUNT,'.',2) GT 0 THEN
		    TEMP.COUNT = FIELD(TEMP.COUNT,'.',1)
		    TEMP.COUNT = TEMP.COUNT + 1
		END
		BEN.CUSTOMER.COUNT = NEW.COUNT
		TEMP.COUNT = TEMP.COUNT + NEW.COUNT - 1
		NEW.COUNT = 1
		IF TEMP.LEN GE 35 THEN
		    FOR I = BEN.CUSTOMER.COUNT TO TEMP.COUNT
			TEMP.VALUE = BEN.ADD[NEW.COUNT,35]
			OFSRECORD := 'BEN.CUSTOMER:':I:':=':TEMP.VALUE:','
			NEW.COUNT = NEW.COUNT + 35
		    NEXT
		END
		ELSE
		    OFSRECORD := 'BEN.CUSTOMER:':BEN.CUSTOMER.COUNT:':=':BEN.ADD[1,35]:','
		END
		OFSRECORD := 'ACCT.WITH.BANK:1:=':BEN_BK_SORT_CD:','

		OFSRECORD:='BEN.OUR.CHARGES=':BEN_OUR_CHARGES:','
		OFSRECORD:='COMMISSION.CODE=':COMMISSION_CODE:','
		CHARGE.COUNT = DCOUNT(COMMISSION_TYPE,'_')

		FOR I = 1 TO CHARGE.COUNT
                    COMM.AMT = ''
                    COMM.CODE = R.CIB.MCP.PARAMS<CIB.MCP.PARAM.COMM.CODE>
                    COMM.TYPE.CR2 = COMMISSION_TYPE['_',I,1]
                    CHANGE VM TO FM IN COMM.CODE
                    LOCATE COMM.TYPE.CR2 IN COMM.CODE SETTING POS THEN
                       COMM.AMT = R.CIB.MCP.PARAMS<CIB.MCP.PARAM.COMM.AMT,POS>
                    END
		    *COMMISSION_AMT = S_CURR_CD:' 0'
                    COMMISSION_AMT = S_CURR_CD:' ':COMM.AMT
		    IF BEN_OUR_CHARGES = 'BEN' THEN
		       *COMMISSION_AMT = T_CURR_CD:' 0'
                        COMMISSION_AMT = T_CURR_CD:' ':COMM.AMT
		    END

		    OFSRECORD := 'COMMISSION.TYPE:':I:':=':COMMISSION_TYPE['_',I,1]:','

		    IF TRIM(COMMISSION_TYPE['_',I,1]) = 'OUTWARDCHG' THEN
		       OFSRECORD := 'COMMISSION.AMT:':I:':=':COMMISSION_AMT:','
		    END
		NEXT


		IF T_CURR_CD NE 'EGP' THEN
		    OFSRECORD := 'BNK.NME.57=':BEN_BK_NAME:','
		END
		VALID.IBAN = ''

		IF LEN(TRIM(BEN_ACC)) = 29 THEN
		    IBAN.ID = BEN_ACC
		    CALL IBANService.ValidateIBAN(IBAN.ID, VALID.IBAN, '')
		END

		IF VALID.IBAN EQ '1' THEN
		    OFSRECORD := 'IBAN.BEN=':BEN_ACC:','
		END
		ELSE
		    OFSRECORD := 'BEN.ACCT.NO=':BEN_ACC:','
		END


	    END
	    ELSE
		IF TXN_TYPE EQ 'AC' OR TXN_TYPE EQ 'ACS2' OR TXN_TYPE EQ 'ACIO' THEN
		    CC.TXN = "FALSE"
		    IF T_ACC_ID[1,1] EQ '4' THEN
			T_ACC_ID = 'EGP1771800060085'	    ;*for Visa Card  EGP1130100010085

			CC.TXN = "TRUE"

		    END
		    ELSE
			IF T_ACC_ID[1,1] EQ '5' THEN

			    T_ACC_ID = 'EGP1771800070085'   ;*for Master Card  EGP1130200010085

			    CC.TXN = "TRUE"

			END
			ELSE

			END
		    END


		    IF CC.TXN = "TRUE" THEN
			IF S_NARR_DTLS NE "Settlement of My Credit Card" THEN
			    S_NARR_DTLS = "Another Credit Card Settlement"
			END
		    END



		    TXN_TYPE = 'ACYR'
		    IF IPN.FLAG EQ "TRUE" THEN
			TXN_TYPE = 'ACIO'
			AUTH.FLAG = '1'
		    END

		    VER.NAME = VER2
		    GOSUB INIT.OFS.MSG
		    CALL F.READ(FN.FILE.AC,S_ACC_ID,R.DEBITCU,F.FILE.AC,ERR.FILE)
