HANDLE.ERROR:
**************


		*RPD.COUNT = DCOUNT(MY.OVERRIDE,'=')
		OVERRIDE.COUNT = 0
		ERROR.COUNT = 0

		FOR J = 1 TO OVERRIDE.CNT
		    CUR.ERR = MY.OVERRIDE[FM,J,1]

		 *   FINDSTR '=' IN CUR.ERR SETTING Ap, Vp THEN
			*CUR.ERR = CUR.ERR['=',2,1]
		  *  END

		    GOSUB SELECT.CR2.OVERRIDE

		    IF MY.OVERRIDE.FLAG EQ '1' THEN
			ERR.FILE = ''
			CALL F.READ(FN.FILE.OVERRIDE,MY.OVER.ID,R.OVERRIDE,F.FILE.OVERRIDE,ERR.FILE)
			IF R.OVERRIDE THEN
			    IF R.OVERRIDE<OVER.ERROR.CODE> EQ '-1' THEN
				OVERRIDE.COUNT + = 1
			    END
			    ELSE
				REPLY.CODE = R.OVERRIDE<OVER.ERROR.CODE>
				ERROR.COUNT = ERROR.COUNT + 1
			    END
			END
		    END
		    ELSE
			REPLY.CODE = '1111'
			ERROR.COUNT +=1
		    END
		    IF COUNT(CUR.ERR,'Balance will fall below Locked') GT 0 THEN
			OVERRIDE.COUNT = 1
			ERROR.COUNT = 0
		    END

		NEXT J
		IF OVERRIDE.COUNT GT 0 AND ERROR.COUNT EQ 0 THEN
		    GTS.CONTROL = 1
		END
		OUT.REF.1 := '1'

RETURN
