		OUT.REF.1 := BOOK_BAL
		OUT.REF.1 := CLR_BAL
		OUT.REF.1 := '1'
		OUT.REF.1 := TGT_BOOK_BAL
		OUT.REF.1 := TGT_CLR_BAL
		REPLY.CODE = '0021'
	    END


	    IF GTS.CONTROL EQ '' THEN

		GOSUB SAVE.MSG
	    END
	    ELSE
		IF OVER.COUNT EQ 0 THEN
		    OVER.COUNT +=1
		    Y.TRIM.DEL = ''
		    Y.TRIM.DEL = '/'
		    Y.TRIM.STRNG = ''
		    Y.TRIM.STRNG = FIELD(OFSRECORD,Y.TRIM.DEL,1,1)
