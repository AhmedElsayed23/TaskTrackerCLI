    SUBROUTINE CIB.MSG.AUTHORIZE.SC(I.PARAM,O.MSG)
*********************************** AUDIT INFORMATION ***********************
* 1. Author&Date created  : NGDE20130731
* 2. Site name            : CIB
* 3. Product              :
* 4. Routine type         : CALL Routine
* 5. Installed            : OFS.SOURCE MAIN
* 6. E.V.B record         : CIB.MSG.FT
*****************************************************************************

********************************** PROGRAM DESCRIPTION **********************
* 7. Description
* -------------------
*  GET A STRING I.PARAM THEN MAKE A FT WITH THE RECORDS SEPARATED IN INPUT STRING AND RETURN OFS MSG
*
*
*
* 8. Incoming arguments
* -------------------------------
* a) I.PARAM
*
* 9. Outgoing arguments
* -------------------------------
* a) O.MSG
*  10.Modification history :
* --------------------------
*  Date             Author                Release Update
*
*  18-July-2018      Srikanth.M            R18 Upgrade Code Retrofit
*                                          Reference: MCBCS-20180718
*****************************************************************************
* Include files

* MCBCS-20180718-S
    $INSERT I_COMMON
    $INSERT I_EQUATE

    $INSERT I_F.CIB.API.FT
    $INSERT I_F.FUNDS.TRANSFER
    $INSERT I_GTS.COMMON

* MCBCS-20180718-S
*****************************************************************************
    GOSUB GET.LOCAL.FIELDS
    GOSUB OPEN.FILES
    GOSUB FT.AUTH
    GOTO PROGRAM.END

*******************************************************************************
OPEN.FILES:
***********
*/////////////////// FUNDS.TRANSFER///////////////////////////////////////////////////////////////
    FN.FT = 'FBNK.FUNDS.TRANSFER'
    F.FT = ''
    CALL OPF(FN.FT,F.FT)

*/////////////////// CIB.API.FT ///////////////////////////////////////////////////////////////
    FN.FILE.CIB.API.FT = 'FBNK.CIB.API.FT'
    F.FILE.CIB.API.FT = ''
    CALL OPF(FN.FILE.CIB.API.FT,F.FILE.CIB.API.FT)

*/////////////////// FUNDS.TRANSFER.NAU ////////////////////////////
    FN.FILE.FUNDS.TRANSFER.NAU = 'FBNK.FUNDS.TRANSFER$NAU'
    F.FILE.FUNDS.TRANSFER.NAU = ''
    CALL OPF(FN.FILE.FUNDS.TRANSFER.NAU,F.FILE.FUNDS.TRANSFER.NAU)

    RETURN
******************************************************************************
FT.AUTH:
********

    VERSION.NAME = 'FUNDS.TRANSFER,OFS'
*VERSION.NAME = 'FUNDS.TRANSFER,TAM.OT103.SERIAL.FTHP.CR2'
    Y.ORDER.CUS  = 'BNK'
    Y.SPRT = '3'
    Y.DELMT = '|'
* HEADER.ID = I.PARAM['|',1,1]
*SRVC.ID   = HEADER.ID['#',1,1]
*CHNL.CODE = HEADER.ID['#',2,1]
*MSG.ID    = HEADER.ID['#',3,1]
*TOKEN.ID  = HEADER.ID['#',4,1]
    HEADER.ID = I.PARAM[Y.DELMT,1,1]
    SRVC.ID   = HEADER.ID[Y.SPRT,1,1]
    CHNL.CODE = HEADER.ID[Y.SPRT,2,1]
    MSG.ID    = HEADER.ID[Y.SPRT,3,1]
    TOKEN.ID  = HEADER.ID[Y.SPRT,4,1]

* MCBCS-20180716-S
*    FT.ID       = TRIM(I.PARAM['|',2,1])
    Y.TRIM.DEL = ''
    Y.TRIM.DEL = '|'
    Y.TRIM.STRNG = ''
    Y.TRIM.STRNG = FIELD(I.PARAM,Y.TRIM.DEL,2,1)
    FT.ID        = TRIM(Y.TRIM.STRNG)
* MCBCS-20180716-E
* MCBCS-20180716-S
*    GTS.CONTROL = TRIM(I.PARAM['|',3,1])
    Y.TRIM.DEL = ''
    Y.TRIM.DEL = '|'
    Y.TRIM.STRNG = ''
    Y.TRIM.STRNG = FIELD(I.PARAM,Y.TRIM.DEL,3,1)
    GTS.CONTROL  = TRIM(Y.TRIM.STRNG)
* MCBCS-20180716-E
* MCBCS-20180716-S
*    AUTH.FLAG   = TRIM(I.PARAM['|',4,1])
    Y.TRIM.DEL = ''
    Y.TRIM.DEL = '|'
    Y.TRIM.STRNG = ''
    Y.TRIM.STRNG = FIELD(I.PARAM,Y.TRIM.DEL,4,1)
    AUTH.FLAG    = TRIM(Y.TRIM.STRNG)
* MCBCS-20180716-E
* MCBCS-20180716-S
*    FUNCTION.ID = TRIM(I.PARAM['|',5,1])
    Y.TRIM.DEL = ''
    Y.TRIM.DEL = '|'
    Y.TRIM.STRNG = ''
    Y.TRIM.STRNG = FIELD(I.PARAM,Y.TRIM.DEL,5,1)
    FUNCTION.ID  = TRIM(Y.TRIM.STRNG)
* MCBCS-20180716-E

* MCBCS-20180716-S
*    IF FUNCTION.ID = 'INPUT' THEN
    IF FUNCTION.ID EQ 'INPUT' THEN
* MCBCS-20180716-E
        FUNCTION.ID = 'I'
    END
* MCBCS-20180716-S
*    IF FUNCTION.ID = 'DELETE' THEN
    IF FUNCTION.ID EQ 'DELETE' THEN
* MCBCS-20180716-E
        FUNCTION.ID = 'D'
    END
* MCBCS-20180716-S
*    IF FUNCTION.ID = 'AUTH' THEN
    IF FUNCTION.ID EQ 'AUTH' THEN
* MCBCS-20180716-E
        FUNCTION.ID = 'A'
    END
* MCBCS-20180716-S
*    IF FUNCTION.ID = 'REVERSE' THEN
    IF FUNCTION.ID EQ 'REVERSE' THEN
* MCBCS-20180716-E
        FUNCTION.ID = 'R'
    END

    IF LEN(FUNCTION.ID) GT 0 THEN
        FUNCTION.ID = FUNCTION.ID[1,1]
    END
* MCBCS-20180716-S
*    IF GTS.CONTROL = '' THEN
    IF GTS.CONTROL EQ '' THEN
* MCBCS-20180716-E
        GTS.CONTROL = '1'
    END
* MCBCS-20180716-S
*    IF AUTH.FLAG = '' THEN
    IF AUTH.FLAG EQ '' THEN
* MCBCS-20180716-E
        AUTH.FLAG = '0'
    END

    CUR.STATUS = '0000'

* MCBCS-20180716-S
*    IF FT.ID[1,2] <> 'FT' THEN
    IF FT.ID[1,2] NE 'FT' THEN
* MCBCS-20180716-E
* MCBCS-20180716-S
*        READ R.CIB.API.FT FROM F.FILE.CIB.API.FT, FT.ID THEN

        CALL F.READ(FN.FILE.CIB.API.FT,FT.ID,R.CIB.API.FT,F.FILE.CIB.API.FT,E.CIB.API.FT)
        IF R.CIB.API.FT THEN
* MCBCS-20180716-E
            FT.ID = R.CIB.API.FT<API.FT.ID>
        END
    END

* MCBCS-20180716-S
*    IF CHNL.CODE = '1' THEN
    IF CHNL.CODE EQ '1' THEN
* MCBCS-20180716-E
* MCBCS-20180716-S
*        READ R.FUNDS.TRANSFER FROM F.FILE.FUNDS.TRANSFER.NAU , FT.ID THEN

        CALL F.READ(FN.FILE.FUNDS.TRANSFER.NAU,FT.ID,R.FUNDS.TRANSFER,F.FILE.FUNDS.TRANSFER.NAU,ERR.FT)
        IF R.FUNDS.TRANSFER THEN
* MCBCS-20180716-E
* MCBCS-20180716-S
*            IF COUNT(R.FUNDS.TRANSFER<FT.INPUTTER>,'OFS.SERVICE.ID') = 0 THEN
            IF COUNT(R.FUNDS.TRANSFER<FT.INPUTTER>,'OFS.SERVICE.ID') EQ 0 THEN
* MCBCS-20180716-E
                CUR.STATUS = '0020'
            END
        END
    END
* MCBCS-20180716-S
*    READ R.FUNDS.TRANSFER FROM F.FILE.FUNDS.TRANSFER.NAU , FT.ID THEN

    CALL F.READ(FN.FILE.FUNDS.TRANSFER.NAU,FT.ID,R.FUNDS.TRANSFER,F.FILE.FUNDS.TRANSFER.NAU,E.FT)
    IF R.FUNDS.TRANSFER THEN
* MCBCS-20180716-E
        VERSION.NAME.FT = R.FUNDS.TRANSFER<FT.LOCAL.REF,VERSION.NAME.POS>
* MCBCS-20180716-S
*        IF VERSION.NAME.FT <> '' THEN
        IF VERSION.NAME.FT NE '' THEN
* MCBCS-20180716-E
            VERSION.NAME = 'FUNDS.TRANSFER':VERSION.NAME.FT
        END
        ELSE
            VERSION.NAME = 'FUNDS.TRANSFER,OFS'
        END
        BRANCH.CODE = R.FUNDS.TRANSFER<FT.CO.CODE>
    END

* MCBCS-20180716-S
*    IF CUR.STATUS = '0000' THEN
    IF CUR.STATUS EQ '0000' THEN
* MCBCS-20180716-E
        OFS.SOURCE.ID = 'CIB.STP'
        OFS.MSG.ERR = ''
        OFS.MSG.ID = ''

        OFSRECORD = VERSION.NAME:'/':FUNCTION.ID:'/PROCESS/':GTS.CONTROL:'/':AUTH.FLAG:',':'OFS.SERVICE2':'/':'123456/':BRANCH.CODE:',':FT.ID:','
* MCBCS- 20180716-S
*        CALL OFS.GLOBUS.MANAGER(OFS.SOURCE.ID,OFSRECORD)
        Y.OLD.OFS.SOURCE.ID = OFS$SOURCE.ID

        CALL OFS.INITIALISE.SOURCE(OFS.SOURCE.ID,'','')
        Y.OFS.ERR = ''
        OFS.RESP = ''
        CALL OFS.BULK.MANAGER(OFSRECORD,OFS.RESP,Y.OFS.ERR)
        OFSRECORD = OFS.RESP
        IF Y.OLD.OFS.SOURCE.ID THEN
            CALL OFS.INITIALISE.SOURCE(Y.OLD.OFS.SOURCE.ID,'',' ')
        END


*        CALL OFS.CALL.BULK.MANAGER(OFS.SOURCE.ID,OFSRECORD,Y.OFS.RES,E.OFS.ERR)
*OFSRECORD = Y.OFS.RES
* MCBCS-20180716-E

* MCBCS-20180716-S
*        VAL = TRIM(OFSRECORD['/',3,1])[',',1,1]
        Y.TRIM.DEL = ''
        Y.TRIM.DEL = '/'
        Y.TRIM.STRNG = ''
        Y.TRIM.STRNG = FIELD(OFSRECORD,Y.TRIM.DEL,3,1)
        VAL  = TRIM(Y.TRIM.STRNG)[',',1,1]
* MCBCS-20180716-E

        CUR.STATUS = '-1'
* MCBCS-20180716-S
*        IF CHNL.CODE = 'CUSTODY' THEN
        IF CHNL.CODE EQ 'CUSTODY' THEN
* MCBCS-20180716-E
            CUR.STATUS = '0008'
        END

        IF VAL EQ '1' THEN
            CUR.STATUS = '1'
            GOSUB UPDATE.DE.PREVIEW
* MCBCS-20180716-S
*            IF CHNL.CODE = 'CUSTODY' THEN
            IF CHNL.CODE EQ 'CUSTODY' THEN
* MCBCS-20180716-E
                CUR.STATUS = '0000'
            END
        END
    END

    O.MSG = HEADER.ID:'|':CUR.STATUS:'|':FT.ID:'|':OFSRECORD

    RETURN
*******************************************************************************
UPDATE.DE.PREVIEW:
******************
    CALL F.READ(FN.FT,FT.ID,R.FT,F.FT,ERR1)
    IF R.FT  THEN
        TXN.TYPE = R.FT<FT.TRANSACTION.TYPE>
* MCBCS-20180716-S
*        IF TXN.TYPE = "OT22" THEN
        IF TXN.TYPE EQ "OT22" THEN
* MCBCS-20180716-E
            MAT R.NEW = '' ; ERROR.CODE = ''
            CALL F.MATREAD(FN.FT,FT.ID,MAT R.NEW,FT.AUDIT.DATE.TIME,F.FT,ERROR.CODE)

            SAVE.MESSAGE = MESSAGE
            SAVE.ID.NEW = ID.NEW
            MESSAGE = 'PREVIEW'
            ID.NEW = FT.ID
            CALL FT.DELIVERY
        END
    END
    RETURN
*******************************************************************************
GET.LOCAL.FIELDS:
*****************

    LOCAL.APPLICATION = 'FUNDS.TRANSFER'
    LOCAL.FIELD = 'VERSION.NAME'
    LOCAL.POSITION = ''

    CALL MULTI.GET.LOC.REF(LOCAL.APPLICATION,LOCAL.FIELD,LOCAL.POSITION)

    VERSION.NAME.POS = LOCAL.POSITION<1,1>
    RETURN
*************************************************************************************
PROGRAM.END:
************
    RETURN
END
