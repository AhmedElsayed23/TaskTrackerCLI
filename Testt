*****************************************************************************
GET.SS.FIELD.NO:
****************
    CALL F.READ(FN.SS, Y.SS.TABLE,R.SS,F.SS,ERR1)
    IF R.SS THEN
        SS.FIELDS.NAMES  = R.SS<SSL.SYS.FIELD.NAME>
        CHANGE VM TO FM IN SS.FIELDS.NAMES
        LOCATE SS.REQ.FIELD IN SS.FIELDS.NAMES SETTING SS.POS.ID THEN
            SS.FIELD.NO = R.SS<SSL.SYS.FIELD.NO,SS.POS.ID,1>
            NEW.LINE = SS.REQ.FIELD:"HAS FIELD NO  = ":SS.FIELD.NO
            GOSUB WRITE.NEW.LINE
        END
        ELSE
            SS.FIELD.NO = ""
            NEW.LINE = SS.REQ.FIELD:"CANNOT FILE FIELD NAME IN SS "
            GOSUB WRITE.NEW.LINE
        END

    END
    RETURN
*****************************************************************************
GET.SS.USER.FIELD.NO:
****************
    CALL F.READ(FN.SS, Y.SS.TABLE,R.SS,F.SS,ERR1)
    IF R.SS THEN
        SS.FIELDS.NAMES  = R.SS<SSL.USR.FIELD.NAME>
        CHANGE VM TO FM IN SS.FIELDS.NAMES
        LOCATE SS.REQ.FIELD IN SS.FIELDS.NAMES SETTING SS.POS.ID THEN
            SS.FIELD.NO = R.SS<SSL.USR.FIELD.NO,SS.POS.ID,1>
            NEW.LINE = SS.REQ.FIELD:"HAS LOCAL FIELD EXIST = "
            GOSUB WRITE.NEW.LINE
            OLD.REQ.LOCAL = SS.REQ.FIELD
            OLD.REQ.USR.NO = SS.FIELD.NO

            SS.REQ.FIELD = "LOCAL.REF"
            GOSUB GET.SS.FIELD.NO
            LOCAL.FIELD.NAME = OLD.REQ.LOCAL
*    LCL.APP.NAME = Y.SS.TABLE
*  GOSUB READ.LOCAL.FIELD.VALUE
            LOCAL.REF.FIELD.NO = SS.FIELD.NO
            LOCAL.FIELD.POS = "<":FIELD(OLD.REQ.USR.NO,"<",2)

        END
        ELSE
            NEW.LINE = SS.REQ.FIELD:"CANNOT FILE FIELD NAME IN SS "
            GOSUB WRITE.NEW.LINE
        END

    END
    RETURN
*****************************************************************************
WRITE.NEW.LINE:
**************
    WRITESEQ NEW.LINE APPEND TO V.FILE.IN ELSE
    END
    RETURN
******************************************************************************
PROGRAM.END:
*************
    RETURN
