    SUBROUTINE CIB.GET.FT.DETAILS(I.PARAM,O.MSG)
*********************************** AUDIT INFORMATION ***********************
* 1. Author&Date created  : HALAFAWY 03/09/2013
* 2. Site name		  : CIB
* 3. Product		  :
* 4. Routine type	  : CALL Routine
* 5. Installed		  : OFS.SOURCE MAIN
* 6. E.V.B record	  : GET FT RECORD DETAILS
*****************************************************************************

********************************** PROGRAM DESCRIPTION **********************
* 7. Description
* -------------------
*  GET A STRING I.PARAM THEN MAKE A FT WITH THE RECORDS SEPARATED IN INPUT STRING AND RETURN OFS MSG
*
*
*
* 8. Incoming arguments
* -------------------------------
* a) I.PARAM
*
* 9. Outgoing arguments
* -------------------------------
* a) O.MSG
**********
* Modification History	   Author
* 02-Jul-2018		   Ravikant		 R18 Upgrade Code Retrofit
*						 MCBCS-20180702
**********
*****************************************************************************
* Insert files
$INSERT I_COMMON
$INSERT I_EQUATE

$INSERT I_F.FUNDS.TRANSFER
$INSERT I_F.CIB.API.FT
*****************************************************************************
    GOSUB OPEN.FILES
    GOSUB GET.LOCAL.FIELDS
    GOSUB GET.DETAILS
    GOTO PROGRAM.END
*******************************************************************************
OPEN.FILES:
***********

*/////////////////// FUNDS.TRANSFER ////////////////////////////////////////////////////////////////
    FN.FILE.FUNDS.TRANSFER = 'FBNK.FUNDS.TRANSFER'
    F.FILE.FUNDS.TRANSFER = ''
    CALL OPF(FN.FILE.FUNDS.TRANSFER,F.FILE.FUNDS.TRANSFER)

*/////////////////// FUNDS.TRANSFER ////////////////////////////////////////////////////////////////
    FN.FILE.FUNDS.TRANSFER.NAU = 'FBNK.FUNDS.TRANSFER$NAU'
    F.FILE.FUNDS.TRANSFER.NAU = ''
    CALL OPF(FN.FILE.FUNDS.TRANSFER.NAU,F.FILE.FUNDS.TRANSFER.NAU)

*/////////////////// FUNDS.TRANSFER HIS ////////////////////////////////////////////////////////////////
    FN.FILE.FUNDS.TRANSFER.HIS = 'FBNK.FUNDS.TRANSFER$HIS'
    F.FILE.FUNDS.TRANSFER.HIS = ''
    CALL OPF(FN.FILE.FUNDS.TRANSFER.HIS,F.FILE.FUNDS.TRANSFER.HIS)

*/////////////////// CIB.API.FT ////////////////////////////
    FN.FILE.CIB.API.FT = 'FBNK.CIB.API.FT'
    F.FILE.CIB.API.FT = ''
    CALL OPF(FN.FILE.CIB.API.FT,F.FILE.CIB.API.FT)

    RETURN
******************************************************************************
GET.LOCAL.FIELDS:
*****************

******************* //// FUNDS.TRANSFER ///// ********************************
    LOCAL.APPLICATION = 'FUNDS.TRANSFER'
    LOCAL.FIELD = 'FT.NARRATIVE':VM:'SRC.CHANNEL'

    LOCAL.POSITION = ''
    CALL MULTI.GET.LOC.REF(LOCAL.APPLICATION,LOCAL.FIELD,LOCAL.POSITION)

    FT.NARRATIVE.POS = LOCAL.POSITION<1,1>
********HEND S20231218*******************************************
    SRC.CHANNEL.POS = LOCAL.POSITION<1,2>
********HEND E20231218*******************************************

    RETURN
*****************************************************************************
GET.FT.REF:
***********
* MCBCS-20180702-S
    * READ R.CIB.API.FT FROM F.FILE.CIB.API.FT, PAR.FT.REF THEN
    CALL F.READ(FN.FILE.CIB.API.FT, PAR.FT.REF,R.CIB.API.FT, F.FILE.CIB.API.FT, ERR.CIBAP)
     IF R.CIB.API.FT THEN
* MCBCS-20180702-E
	PAR.FT.REF = R.CIB.API.FT<API.FT.ID>
    END

    RETURN
*****************************************************************************
GET.DETAILS:
*************
    HEADER.ID	 = I.PARAM['|',1,1]

    SRVC.ID	 = HEADER.ID['#',1,1]
    CHNL.CODE	 = HEADER.ID['#',2,1]
    MSG.ID	 = HEADER.ID['#',3,1]
    TOKEN.ID	 = HEADER.ID['#',4,1]

* MCBCS-20180702-S
*    PAR.FT.REF = TRIM(I.PARAM['|',2,1])
Y.TRIM.DEL = ''
Y.TRIM.DEL = '|'
Y.TRIM.STRNG = ''
Y.TRIM.STRNG = FIELD(I.PARAM,Y.TRIM.DEL,2,1)
    PAR.FT.REF	= TRIM(Y.TRIM.STRNG)
* MCBCS-20180702-E
* MCBCS-20180702-S
*    IF LEN(PAR.FT.REF) > 12 OR PAR.FT.REF[1,2] <> 'FT' THEN
    IF LEN(PAR.FT.REF) GT 12 OR PAR.FT.REF[1,2] NE 'FT' THEN
* MCBCS-20180702-E
	GOSUB GET.FT.REF
    END

    MY.SEP = '|'

    R.FUNDS.TRANSFER = ''
* MCBCS-20180702-S
   * READ R.FUNDS.TRANSFER FROM F.FILE.FUNDS.TRANSFER.NAU , PAR.FT.REF THEN
     CALL F.READ(FN.FILE.FUNDS.TRANSFER.NAU, PAR.FT.REF, R.FUNDS.TRANSFER, F.FILE.FUNDS.TRANSFER.NAU, ERR.FTNAU)
  IF R.FUNDS.TRANSFER THEN
	GOSUB FIL.DET
    END
    ELSE
     *	 READ R.FUNDS.TRANSFER FROM F.FILE.FUNDS.TRANSFER , PAR.FT.REF THEN
		CALL F.READ(FN.FILE.FUNDS.TRANSFER, PAR.FT.REF, R.FUNDS.TRANSFER, F.FILE.FUNDS.TRANSFER, ERR.FT)
		IF R.FUNDS.TRANSFER THEN
	      GOSUB FIL.DET
		END
		ELSE
	        CALL F.READ(FN.FILE.FUNDS.TRANSFER.HIS, PAR.FT.REF:';2', R.FUNDS.TRANSFER, F.FILE.FUNDS.TRANSFER.HIS, ERR.FTHIS)
	        IF R.FUNDS.TRANSFER THEN
				GOSUB FIL.DET
	        END
			ELSE
				CALL F.READ(FN.FILE.FUNDS.TRANSFER.HIS, PAR.FT.REF:';1', R.FUNDS.TRANSFER, F.FILE.FUNDS.TRANSFER.HIS, ERR.FTHIS)
				IF R.FUNDS.TRANSFER THEN
					GOSUB FIL.DET
				END
				ELSE
					O.MSG = '0001#':MY.SEP
				 END
			END
		END
	END

    O.MSG = HEADER.ID:'#':O.MSG

    RETURN
*******************************************************************************
FIL.DET:
********

    O.MSG =  '0000#':MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.TRANSACTION.TYPE>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.DEBIT.VALUE.DATE>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.CO.CODE>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.PROFIT.CENTRE.DEPT>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.DEBIT.ACCT.NO>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.DEBIT.CURRENCY>:MY.SEP
*20170920 CHANGED TO GET AMOUNT DEBITED TO PREVENT NULL VALUES
    O.MSG := R.FUNDS.TRANSFER<FT.AMOUNT.DEBITED>[4,20]:MY.SEP
*    O.MSG := R.FUNDS.TRANSFER<FT.DEBIT.AMOUNT>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.DEBIT.THEIR.REF>:MY.SEP
  *  O.MSG := CHANGE(R.FUNDS.TRANSFER<FT.BEN.CUSTOMER>,@VM,'^'):MY.SEP
	O.MSG := CHANGE(R.FUNDS.TRANSFER<FT.BEN.CUSTOMER>,VM,'^'):MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.BEN.ACCT.NO>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.BEN.CUSTOMER,1>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.BEN.CUSTOMER,2>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.BEN.CUSTOMER,3>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.BEN.OUR.CHARGES>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.BEN.BANK>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.ACCT.WITH.BANK>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.BC.BANK.SORT.CODE>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.LOCAL.REF,FT.NARRATIVE.POS>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.BEN.OUR.CHARGES>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.COMMISSION.CODE>:MY.SEP
 *   O.MSG := CHANGE(R.FUNDS.TRANSFER<FT.COMMISSION.TYPE>,@VM,'^'):MY.SEP
 *   O.MSG := CHANGE(R.FUNDS.TRANSFER<FT.COMMISSION.AMT>,@VM,'^'):MY.SEP
 *   O.MSG := CHANGE(R.FUNDS.TRANSFER<FT.ORDERING.CUST>,@VM,'^'):MY.SEP

	O.MSG := CHANGE(R.FUNDS.TRANSFER<FT.COMMISSION.TYPE>,VM,'^'):MY.SEP
    O.MSG := CHANGE(R.FUNDS.TRANSFER<FT.COMMISSION.AMT>,VM,'^'):MY.SEP
    O.MSG := CHANGE(R.FUNDS.TRANSFER<FT.ORDERING.CUST>,VM,'^'):MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.ORDERING.BANK>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.CREDIT.ACCT.NO>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.CUSTOMER.SPREAD>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.CUSTOMER.RATE>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.DEAL.MARKET>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.LOCAL.REF,FT.NARRATIVE.POS>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.INTERMED.BANK.ACC>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.INTERMED.BANK>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.ACCT.WITH.BK.ACNO>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.ACCT.WITH.BANK>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.PAYMENT.DETAILS>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.BK.TO.BK.OUT>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.INPUTTER>:MY.SEP

    O.MSG := R.FUNDS.TRANSFER<FT.CREDIT.CURRENCY>:MY.SEP
*20170920
    O.MSG := R.FUNDS.TRANSFER<FT.AMOUNT.CREDITED>[4,20]:MY.SEP
*   O.MSG := R.FUNDS.TRANSFER<FT.CREDIT.AMOUNT>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.TREASURY.RATE>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.CREDIT.VALUE.DATE>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.OVERRIDE>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.RECORD.STATUS>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.DATE.TIME>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.AUTHORISER>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.CURR.NO>:MY.SEP
    O.MSG := R.FUNDS.TRANSFER<FT.DEPT.CODE>:MY.SEP
    O.MSG := PAR.FT.REF:MY.SEP
**********HEND S20231218*****************************************
    O.MSG := R.FUNDS.TRANSFER<FT.LOCAL.REF,SRC.CHANNEL.POS>:MY.SEP
**********HEND E20231218*****************************************
    RETURN
*******************************************************************************
PROGRAM.END:
************
    RETURN
END

