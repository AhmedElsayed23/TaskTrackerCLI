    END
    ELSE
        IF PAR.COUNT EQ 0 THEN
            OFSRECORD := FIELD.NAME:':1:1=':PAR.VALUE:','
        END
        ELSE
            FOR I = 1 TO MAX.COUNT
                IF I GT PAR.COUNT THEN
