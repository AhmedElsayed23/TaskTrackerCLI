		    TXN_TYPE = ORG_TXN_TYPE
		    IF IPN.FLAG EQ "TRUE" THEN
			TXN_TYPE = 'ACIO'
			BEN_OUR_CHARGES = CHARGE_IND
			IF BEN_OUR_CHARGES = "" THEN
			    BEN_OUR_CHARGES = "SHA"
			END
			IF BEN_OUR_CHARGES = "OUR" THEN
			    COMMISSION_CODE = "DEBIT PLUS CHARGES"
			    CHARGE.FOR = 'SENDER'
			    IPN.CREDIT.AMT = S_AMT
			END
			IF BEN_OUR_CHARGES = "BEN" THEN
			    COMMISSION_CODE = "CREDIT LESS CHARGES"
			    CHARGE.FOR = 'SENDER'
			    IPN.CREDIT.AMT = S_AMT - COMM.AMT
			END
