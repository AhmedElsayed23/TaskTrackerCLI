ELSE
GOSUB HANDLE.ERROR
END
END
ELSE
GOSUB HANDLE.ERROR
END
CASE 1
    GOSUB HANDLE.ERROR
END CASE
IF OVERRIDE.COUNT GT 0 AND ERROR.COUNT EQ 0 THEN
		    GTS.CONTROL = 1
END
OUT.REF.1 := '1'
RETURN
