************HEND S20250126*******************************
    IF FIELD.NAME = 'BEN.CUSTOMER' THEN
	   IF BEN.NAME.COUNT > 4 THEN
	      PAR.COUNT = 4
	   END
	END 
***********HEND E20250120**********************************

    CUR.COUNT = DCOUNT(CUR.VALUE,VM)

    MAX.COUNT = CUR.COUNT
    IF PAR.COUNT GT MAX.COUNT THEN
        MAX.COUNT = PAR.COUNT
    END

    IF PAR.VALUE EQ "NULL" THEN
        OFSRECORD := FIELD.NAME:'::=':'NULL':','
    END
    ELSE
        IF PAR.COUNT EQ 0 THEN
            OFSRECORD := FIELD.NAME:':1:=':PAR.VALUE:','
        END
        ELSE
            FOR I = 1 TO MAX.COUNT
                IF I GT PAR.COUNT THEN
                    OFSRECORD := FIELD.NAME:':':I:':="-",'
                END
                ELSE
                    OFSRECORD := FIELD.NAME:':':I:':=':PAR.VALUE['_',I,1]:','
                END
            NEXT
        END
    END

    RETURN
