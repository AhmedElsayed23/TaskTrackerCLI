   END
   IF ((R.CRRE EQ '' )OR (REPLY.CODE NE '1001')) THEN

	VER1 = 'FUNDS.TRANSFER,TAM.OT103.SERIAL.FTHP'
	VER2 = 'FUNDS.TRANSFER,TAM.ACTR.FTHP.CR2'

	Y.ORDER.CUS = 'BNK'
