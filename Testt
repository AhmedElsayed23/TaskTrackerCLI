********************************************************************************
READ.FILE.SAMPLE:
*****************
    Y.NEW.VALUE = "NULL"
    NO.OF.TAGS = 0
    BODY.ARRAY.NAME = ""
    BODY.ARRAY.VALUE = ""

    MAIN.APPLICATION.NAME = FIELD(MAIN.APP,"|",1)
    MAIN.APPLICATION.ID = FIELD(MAIN.APP,"|",2)
    ID.NEW = MAIN.APPLICATION.ID
    GOSUB READ.MAIN.APP.NEW
    MY.FILE = R.CIB.SMS.FORMAT<CIBSF.BODY.FILE.NAME>
    ALL.DIR = R.CIB.SMS.FORMAT<CIBSF.BODY.LOC>
    MSG.TYPE = "XML"

    NO.OF.LINES = 0
    MSG.FORMAT = ""
    EOF = 0
    OPENSEQ ALL.DIR , MY.FILE TO V.FILE.COMPARE THEN
        LOOP WHILE NOT(EOF)
            CURRENT.ALL.LINE = ''
            READSEQ CURRENT.ALL.LINE FROM V.FILE.COMPARE THEN
                IF CURRENT.ALL.LINE EQ '' THEN
                    EOF = 1
                    CLOSE MY.FILE
                END
                ELSE
*                    NO.OF.LINES ++
                    NO.OF.LINES = NO.OF.LINES + 1
                    TEMP.MSG = TRIM(CURRENT.ALL.LINE)
                    GOSUB CHECK.LINE
                END
            END
            ELSE
                EOF = 1
                CLOSE MY.FILE
            END
        REPEAT
    END

    CHANGE "|" TO " " IN MSG.FORMAT
    CHANGE FM TO "" IN MSG.FORMAT
    GOSUB WRITE.OUTPUT
CLOSESEQ V.FILE.COMPARE
    RETURN

********************************************************************************
