        IF R.CO THEN
            R.TEMP := R.CO<CIB.TT.CBE.CODE.CBE.CODE> : MY.SEP
        END
        ELSE
            R.TEMP := ' ' : MY.SEP
        END
    END
    ELSE
        R.TEMP := ' ' : MY.SEP
    END
***** PAYMENT OF DETAIL
    KEY.LIST.CO = '' ; SELECTED.CO = '' ; ERROR.MSG.CO = '' ; T.SEL.CO = ''
    T.SEL.CO  = "SELECT ":FN.FILE.CO:" WITH GROUP.CODE EQ '3' AND CIB.CODE EQ ":R.CU<EB.CUS.INDUSTRY>
    CALL EB.READLIST(T.SEL.CO, KEY.LIST.CO, '', SELECTED.CO, ERROR.MSG.CO)

    IF SELECTED.CO GT 0 THEN
        R.CO = ''
        CALL F.READ(FN.FILE.CO, KEY.LIST.CO, R.CO, F.FILE.CO, ERR.CO)
        IF R.CO THEN
            R.TEMP := R.CO<CIB.TT.CBE.CODE.CBE.CODE> : MY.SEP
        END
        ELSE
            R.TEMP := ' ' : MY.SEP
        END
    END
    ELSE
        R.TEMP := ' ' : MY.SEP
    END

    RETURN
***********************************************************************
GET.SECTOR:
*************
****PAYMENT CODE
    KEY.LIST.CO = '' ; SELECTED.CO = '' ; ERROR.MSG.CO = '' ; T.SEL.CO = ''
    T.SEL.CO  = "SELECT ":FN.FILE.CO:" WITH GROUP.CODE EQ '5' AND CIB.CODE EQ ":R.CU<EB.CUS.SECTOR>
    CALL EB.READLIST(T.SEL.CO, KEY.LIST.CO, '', SELECTED.CO, ERROR.MSG.CO)

    IF SELECTED.CO GT 0 THEN
        R.CO = ''
        CALL F.READ(FN.FILE.CO, KEY.LIST.CO, R.CO, F.FILE.CO, ERR.CO)
        IF R.CO THEN
            R.TEMP := R.CO<CIB.TT.CBE.CODE.CBE.CODE> : MY.SEP
        END
        ELSE
            R.TEMP := ' ' : MY.SEP
        END
    END
    ELSE
        R.TEMP := ' ' : MY.SEP
    END
***** SEGMENT
    KEY.LIST.CO = '' ; SELECTED.CO = '' ; ERROR.MSG.CO = '' ; T.SEL.CO = ''
    T.SEL.CO  = "SELECT ":FN.FILE.CO:" WITH GROUP.CODE EQ '6' AND CIB.CODE EQ ":R.CU<EB.CUS.SECTOR>
    CALL EB.READLIST(T.SEL.CO, KEY.LIST.CO, '', SELECTED.CO, ERROR.MSG.CO)

    IF SELECTED.CO GT 0 THEN
        R.CO = ''
        CALL F.READ(FN.FILE.CO, KEY.LIST.CO, R.CO, F.FILE.CO, ERR.CO)
        IF R.CO THEN
            R.TEMP := R.CO<CIB.TT.CBE.CODE.CBE.CODE> : MY.SEP
        END
        ELSE
            R.TEMP := ' ' : MY.SEP
        END
    END
    ELSE
        R.TEMP := ' ' : MY.SEP
    END

    RETURN
***********************************************************************
PROGRAM.END:
************
    RETURN
END
