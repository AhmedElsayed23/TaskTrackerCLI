	DEBIT.CUSTOMER = ''
	CREDIT.CUSTOMER = ''
	R.ACDE = ''
	R.ACCR = ''
	SUF.BAL = 0
	BOOK_BAL = 0
	CLR_BAL = 0
	TGT_BOOK_BAL = 0
	TGT_CLR_BAL = 0

KYC.POS = ''
	*CUR.VAR = S_AMT
	*GOSUB AMOUNT.FORMAT
