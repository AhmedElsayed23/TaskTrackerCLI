    SUBROUTINE VIR.CIB.CUS.JOINT.DEL.TEST
*********************************** AUDIT INFORMATION ***********************
* TEST ROUTINE - NOT FOR PRODUCTION
* Purpose: Verify whether DEL on a CORE multivalue field (RELATION.CODE /
* REL.CUSTOMER) reflects correctly in the browser under a VIR (record-level)
* routine, as opposed to a local ref group under EB.CUS.LOCAL.REF.
*
* Logic under test: remove any RELATION.CODE / REL.CUSTOMER row pair where
* RELATION.CODE is blank but REL.CUSTOMER is populated (an "orphan" row) -
* this mirrors the kind of cleanup your production routine does on the local
* group, but applied to the core field instead.
*******************************************************************************
* Include files

    $INSERT I_COMMON
    $INSERT I_EQUATE
    $INSERT I_F.CUSTOMER

*****************************************************************************
    GOSUB PROCESS
    GOTO PROGRAM.END

    RETURN
**************************************************************************************************************
PROCESS:
********

    Y.REL.CODES = R.NEW(EB.CUS.RELATION.CODE)
    Y.REL.CUSTS = R.NEW(EB.CUS.REL.CUSTOMER)

    Y.REL.COUNT = DCOUNT(Y.REL.CODES, @VM)

    IF Y.REL.COUNT EQ 0 THEN
        RETURN
    END

    * Loop backwards so DEL doesn't shift the indices of rows still to be checked
    FOR Y.I = Y.REL.COUNT TO 1 STEP -1

        Y.CURRENT.CODE = Y.REL.CODES<1, Y.I>
        Y.CURRENT.CUST = Y.REL.CUSTS<1, Y.I>

        * Orphan test condition: code blank, customer populated
        IF Y.CURRENT.CODE EQ '' AND Y.CURRENT.CUST NE '' THEN

            DEL R.NEW(EB.CUS.RELATION.CODE)<1, Y.I>
            DEL R.NEW(EB.CUS.REL.CUSTOMER)<1, Y.I>

            * Surface an error so we can see the record state in the browser
            * immediately after the DEL, without needing to hold/reopen
            AF = EB.CUS.RELATION.CODE
            AV = Y.I

            ETEXT = "TEST: DEL fired on core RELATION.CODE/REL.CUSTOMER row ":Y.I
            CALL STORE.END.ERROR

        END

    NEXT Y.I

    RETURN
**************************************************************************************************************
PROGRAM.END:
************
    RETURN
END
