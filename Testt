						END ELSE
							IF yLarCurrency EQ 'EGP' THEN
								yTotBalMaleEGP = yTotBalMaleEGP + yWorkingBal 
								countEGPMale = countEGPMale + 1
							END
						END
					END				
					
					
					
				END
				
				IF yGender EQ 'FEMALE' THEN
